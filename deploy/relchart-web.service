[Unit]
Description=Relative daily closing-price charts
Wants=network-online.target
After=network-online.target relchart-firewall.service
Requires=relchart-firewall.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=relchart
Group=relchart
EnvironmentFile=/etc/relchart/relchart.env
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 XDG_CACHE_HOME=/var/cache/relchart
StateDirectory=relchart
StateDirectoryMode=0700
CacheDirectory=relchart
CacheDirectoryMode=0700
ExecStart=/usr/bin/python3 /usr/local/libexec/relchart/start.py
Restart=on-failure
RestartSec=10s
TimeoutStopSec=30s
UMask=0077
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
CPUQuota=100%
MemoryHigh=768M
MemoryMax=1G
TasksMax=128

[Install]
WantedBy=multi-user.target
